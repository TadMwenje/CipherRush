# Public OAuth client IDs for CipherRush builds (`yarn build`, `npm run sync`).
# These are identifiers, not secrets - they ship inside every app binary anyway.
# Never put a client secret or private key in a REACT_APP_ variable.
# A variable set in the shell or in .env.production.local overrides these.

# iOS OAuth client (bundle com.aximoix.cipherrush), Google Cloud project cipherrush-auth
REACT_APP_GOOGLE_IOS_CLIENT_ID=548808788960-3jtmc07lqac6u2ff2khud4t3hhc8bpj0.apps.googleusercontent.com

# Web OAuth client - required for Google on Android and the web. Not created yet.
REACT_APP_GOOGLE_WEB_CLIENT_ID=

# Production API (HTTPS origin, no trailing slash). Required for native builds:
# `npm run sync` in mobile/ refuses to bundle while this is missing or plain HTTP.
# The web dev server keeps using frontend/.env (http://localhost:8000).
REACT_APP_BACKEND_URL=https://cipherrush-api.onrender.com
