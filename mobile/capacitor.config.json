{
  "appId": "com.aximoix.cipherrush",
  "appName": "CipherRush",
  "webDir": "../frontend/build",
  "backgroundColor": "#0A0E1A",
  "server": {
    "androidScheme": "https"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0A0E1A"
  },
  "android": {
    "backgroundColor": "#0A0E1A"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "CapacitorCookies": {
      "enabled": true
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "apple": true,
        "facebook": false,
        "twitter": false
      }
    }
  }
}
