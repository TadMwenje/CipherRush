POSTGRES_USER=cipherrush
POSTGRES_PASSWORD=changeme
POSTGRES_DB=cipherrush
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cipherrush:changeme@localhost:5432/cipherrush
# Web dev servers + the native app origins (Capacitor iOS / Android).
CORS_ORIGINS=http://localhost:3001,http://localhost:3000,capacitor://localhost,https://localhost
# 32+ random characters, e.g. openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
# true in production (HTTPS only)
COOKIE_SECURE=false
# Production: "none" (requires COOKIE_SECURE=true) so the session cookie survives
# the cross-site hop from the app's origin to the API. "lax" is fine for local dev.
COOKIE_SAMESITE=lax

# --- Sign in with Google / Apple (leave blank to hide the buttons) ---
# Comma-separated OAuth client IDs whose ID tokens we accept (audience check).
# Include the Web client ID (also used by Android as serverClientId) and the iOS client ID.
GOOGLE_CLIENT_IDS=
# Comma-separated: the iOS bundle id (com.aximoix.cipherrush) and the web Services ID.
APPLE_CLIENT_IDS=com.aximoix.cipherrush
# Server-to-server Apple API (code exchange + token revocation on account deletion).
# Key from developer.apple.com > Keys (Sign in with Apple). NEVER ship these to the app.
APPLE_TEAM_ID=
APPLE_KEY_ID=
# The .p8 file contents on one line, with \n for newlines.
APPLE_PRIVATE_KEY=
